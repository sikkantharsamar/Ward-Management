# Copy this file to .env and change the values. NEVER commit .env to GitHub.
SECRET_KEY=put-a-long-random-string-here
DATABASE_URL=sqlite:///./ward.db
# PostgreSQL example (after docker compose up -d):
# DATABASE_URL=postgresql+psycopg2://ward:ward_password@localhost:5432/ward_db
ACCESS_TOKEN_EXPIRE_MINUTES=480
ESCALATION_SECONDS=60
